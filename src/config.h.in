#ifndef CONFIG_H_IN
#define CONFIG_H_IN

// The full descriptive version — the triple plus commit distance, hash and
// dirty marker when the build is not exactly a tagged release. This is what
// every user-facing surface (banner, About, startup log) must show: a build
// that prints only the triple is claiming to be a release it is not.
#define LIBRECELIK_VERSION_FULL "@LIBRECELIK_VERSION_FULL@"
#define LIBRECELIK_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@"

#endif // CONFIG_H_IN
